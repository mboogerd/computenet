### Python ###
# Bytecode caches, e.g. from .claude/skills/work/scripts/. Generated on every
# run of a helper script, so tracking one lands a binary blob on main that
# churns per interpreter version (cpython-314.pyc et al).
__pycache__/
*.py[cod]

### Mac OS ###
.DS_Store
# Claude Code session worktrees
.claude/worktrees/

# Headless plan orchestrator runtime state (logs, prompts, worktrees metadata)
.codex-orchestrator/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.claude/last-sync.json

# beads_viewer (bv) local state
.bv/

# Mutation-check marker (computenet-leg). Written by an implementer while it
# deliberately breaks production code to prove a test catches it, and removed
# when the code is restored. It exists so an agent inheriting a crashed
# worktree can tell a LIVE MUTATION from finished work — committing one is a
# silently broken production change. Never a tracked file.
.mutation-in-progress
